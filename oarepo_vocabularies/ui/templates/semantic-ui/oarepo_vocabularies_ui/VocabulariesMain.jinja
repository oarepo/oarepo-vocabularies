{#def record, d, extra_context, hierarchical=False #}
{% set vocabularyType = extra_context.get("vocabularyType", "")%}
{% set vocabularyMetadata = config.get("INVENIO_VOCABULARY_TYPE_METADATA", {}).get(vocabularyType, {}) %}
{% set vocabularyTitle = vocabularyMetadata.get("title", {}).get(current_i18n.language) %}
{% set vocabularySearchTitle = vocabularyTitle if vocabularyTitle else '"' + vocabularyType + '"' if vocabularyType else "" %}
<div class="vocabularies-main">
  <VocabulariesBreadcrumb extra_context={{extra_context}} record={{record}} d={{d.title}} vocabularySearchTitle={{vocabularySearchTitle}} hierarchical={{hierarchical}}/>
  <VocabularyTitle d={{d.title}} record={{record}} subheader={{vocabularySearchTitle}} />
  {% if record.description %}
  <section id="description" class="rel-mt-2" aria-label="{{ _('Description') }}">
    <p>{{ ui_value(d.description, "l10n") }}</p>
  </section>
  {% endif %}
  <dl class="ui very basic table vocabularies-metadata">
    {% if record.id %}
    <dt>{{ _('id')|capitalize }}</dt>
    <dd>
      {{ record.id }}
    </dd>
    {% endif %}
    {{ catalog.render_first_existing(
      [
          "VocabularyExtraInfo." + extra_context.vocabularyType|replace(":", "_"),
          "EmptyComponent"
      ],
      record=record,
      extra_context=extra_context,  
      d=d,
      hierarchical=hierarchical
    ) }}
    {% if record.identifiers %}
      <dt>{{_("vocabulary.identifiers")}}</dt>
      <dd>
        <VocabularyItemIdentifiers identifiers={{record.identifiers}} />
      </dd>
    {% endif %}
    {% if record.affiliations %}
    <dt>{{_("vocabulary.affiliations")}}</dt>
    <dd>
      {% for affiliation in record.affiliations %}
        <span>{{affiliation.name}}</span>{% if not loop.last %}, {% endif %}
      {% endfor %}
    </dd>
  {% endif %}



    {% for prop, val in (record.props or {}).items() %}
     {% if val %}
      {% set prop_label = vocabularyMetadata.get("props", {}).get(prop, {}).get("label") or _("vocabulary." + prop) %}
      <dt>{{ prop if prop_label == "vocabulary." + prop else prop_label }}</dt>
      <dd>{{val}}</dd>
     {% endif %}
    {% endfor %}



    {% if record.tags and record.tags | length > 0 %}
    <dt>{{_("vocabulary.tags")}}</dt>
    <dd>
    {% for t in record.tags %}
    <span class="ui tag label {% if t =='featured' -%}red{%- endif %}">{{t}}</span>
    {% endfor %}
    </dd>
    {% endif %}
  </dl>
  {% if record.mappings %}
  {% set relation_labels = {
    "exactMatch": _("Exact match"),
    "closeMatch": _("Close match"),
    "broadMatch": _("Broad match"),
    "narrowMatch": _("Narrow match"),
    "relatedMatch": _("Related match"),
  } %}
  <section id="mappings" class="rel-mt-2" aria-labelledby="mappings-heading">
    <h2 id="mappings-heading" class="ui medium header">{{ _("Mappings") }}</h2>
    <table class="ui very basic compact unstackable table">
      <thead>
        <tr>
          <th>{{ _("Relation") }}</th>
          <th>{{ _("Identifier") }}</th>
          <th>{{ _("Scheme") }}</th>
        </tr>
      </thead>
      <tbody>
      {% for mapping in record.mappings %}
        <tr>
          <td><span title="skos:{{ mapping.relation }}">{{ relation_labels.get(mapping.relation, mapping.relation) }}</span></td>
          <td>
            {% if mapping.identifier.startswith("http") %}
            <a href="{{ mapping.identifier }}" target="_blank" rel="noopener noreferrer">{{ mapping.identifier }}</a>
            {% else %}
            {{ mapping.identifier }}
            {% endif %}
          </td>
          <td>{{ mapping.scheme }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}
  {% set custom_field_config=config.get("VOCABULARIES_CF_UI", {}).get(vocabularyType, None) %}
  {%if custom_field_config %}
    <div class="ui vocabulary_cf">
      <ICustomFields custom_fields_config={{custom_field_config}} d={{d.custom_fields}} />
    </div>
  {% endif %}
</div>